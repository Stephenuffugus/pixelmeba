{
  "name": "pixelmeba",
  "version": "0.0.0",
  "private": true,
  "description": "Grow a tiny living world. Change one thing. See what happens.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test",
    "content:validate": "tsx tools/content-validate.ts",
    "sim:run": "tsx tools/sim-run.ts",
    "sim:tune": "tsx tools/sim-tune.ts",
    "render:bench": "tsx tools/render-bench-run.ts",
    "art:build": "tsx tools/art-build.ts",
    "store:assets": "tsx tools/store-assets.ts",
    "bug:export": "tsx tools/bug-export.ts",
    "android:sync": "tsx tools/android-sync.ts",
    "format": "prettier --write .",
    "art:preview": "tsx tools/art-preview.ts"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@preact/signals": "2.11.2",
    "pixi.js": "8.21.0",
    "preact": "10.29.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.3",
    "@types/pngjs": "6.0.5",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
